#!/usr/bin/env python3
"""
Docker-to-Apple-Container shim for Hermes Agent — per-project containers.

Hermes Agent shells out to `docker`. This script stands in for it and drives
Apple's `container` CLI instead, with one addition: containers are partitioned
by *Hermes project*, so each project gets its own container with its own
directory bind-mounted at /workspace.

How the per-project part works
------------------------------
Hermes already reuses containers per (task_id, profile) — see
`DockerEnvironment._find_reusable_container` in tools/environments/docker.py.
It finds them with:

    docker ps -a --filter label=hermes-task-id=<id> --format "{{.ID}}\t{{.State}}"

Apple Container supports labels but has no `--filter` and no Go templates, so
that probe always fails against a naive translator — Hermes then starts a fresh
container on every launch (container sprawl) and never reuses one.

This shim implements `ps` faithfully (client-side filtering + a Go-template
subset over `container list --format json`), which restores Hermes' native
reuse. On top of that it rewrites, at `docker run` time:

  * the `hermes-task-id` label      -> "<task-id>.<project-slug>"
  * the source of the /workspace mount -> the active project's primary path
  * the sandbox home dir            -> a per-project directory

Because reuse is keyed on that label, scoping the label is all it takes to get
one container per project — and Hermes finds the right one by itself, with no
name-hijacking or mapping table.

The active project is read from Hermes' own projects database
(~/.hermes/projects.db, `project_meta.active_id`), which is the same source of
truth the desktop UI and the `project_switch` tool write to.

Config: ~/.hermes/docker-wrapper.json (all keys optional)
Env:    HERMES_PROJECT_SLUG   force a project slug (overrides the DB)
        HERMES_WRAPPER_DEBUG  =1 to log every translated command to stderr
"""

import fcntl
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile

CONTAINER_BIN = shutil.which("container") or "/usr/local/bin/container"
HERMES_HOME = os.path.expanduser(os.environ.get("HERMES_HOME", "~/.hermes"))
PROJECTS_DB = os.path.join(HERMES_HOME, "projects.db")
CONFIG_PATH = os.path.join(HERMES_HOME, "docker-wrapper.json")
CONFIG_LOCK_PATH = CONFIG_PATH + ".lock"
SANDBOX_ROOT = os.path.join(HERMES_HOME, "sandboxes", "docker")

DEBUG = os.environ.get("HERMES_WRAPPER_DEBUG") == "1"

# Docker label values are restricted to this set by Hermes' own
# _sanitize_label_value(); we scope task ids with "." which stays inside it.
_LABEL_SAFE_RE = re.compile(r"[^A-Za-z0-9_.-]")
TASK_LABEL = "hermes-task-id"

# Apple Container has no equivalent; drop the flag and its value.
STRIP_WITH_VALUE = frozenset({
    "--security-opt", "--restart", "--add-host", "--pids-limit", "--storage-opt",
    "--health-cmd", "--health-interval", "--health-retries", "--health-timeout",
    "--health-start-period", "--mac-address", "--log-driver", "--log-opt",
    "--stop-signal", "--stop-timeout", "--userns", "--ipc", "--pid", "--cgroupns",
    "--annotation", "--device", "--group-add", "--sysctl", "--blkio-weight",
    "--memory-swap", "--memory-reservation", "--oom-score-adj", "--cpu-shares",
})

# Apple Container has no equivalent; drop the flag alone.
STRIP_FLAGS = frozenset({
    "--privileged", "--no-healthcheck", "--oom-kill-disable", "--sig-proxy",
})


def log(msg):
    print(f"[docker-wrapper] {msg}", file=sys.stderr)


def debug(msg):
    if DEBUG:
        log(msg)


# --------------------------------------------------------------------------
# Config
# --------------------------------------------------------------------------

DEFAULT_CONFIG = {
    # When false, the shim is a pure translator: no label scoping, no mount
    # rewriting. Useful for bisecting a problem.
    "per_project": True,
    # Mounts whose target is /workspace get their source repointed at the
    # active project. Extra mounts *under* /workspace (e.g. a nested
    # ":/workspace/Sub" entry in terminal.docker_volumes) belong to whichever
    # project they were written for; when true they are dropped for every
    # other project rather than leaking one project's files into another.
    "drop_foreign_subworkspace_mounts": True,
    # Fallback when no project is active (or the DB is unreadable).
    "fallback_project_path": "",
}


def _acquire_lock():
    os.makedirs(os.path.dirname(CONFIG_LOCK_PATH), exist_ok=True)
    fd = open(CONFIG_LOCK_PATH, "w")
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def _release_lock(fd):
    fcntl.flock(fd, fcntl.LOCK_UN)
    fd.close()


def load_config():
    config = dict(DEFAULT_CONFIG)
    try:
        with open(CONFIG_PATH) as f:
            stored = json.load(f)
        if isinstance(stored, dict):
            config.update(stored)
    except (OSError, ValueError):
        pass
    return config


def save_config(config):
    lock_fd = _acquire_lock()
    try:
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        fd, tmp_path = tempfile.mkstemp(dir=os.path.dirname(CONFIG_PATH), suffix=".tmp")
        try:
            with os.fdopen(fd, "w") as f:
                json.dump(config, f, indent=2)
            os.replace(tmp_path, CONFIG_PATH)
        except Exception:
            os.unlink(tmp_path)
            raise
    finally:
        _release_lock(lock_fd)


# --------------------------------------------------------------------------
# Project resolution
# --------------------------------------------------------------------------

def _connect_projects_db(db_path):
    """Open projects.db for reading, or return None.

    projects.db runs in WAL mode. A read-only open of a WAL database needs the
    -shm sidecar, and if that has been checkpointed away SQLite must create it
    — which a `mode=ro` connection cannot do, failing with "unable to open
    database file". So prefer read-only, then fall back to a normal connection
    (which is what Hermes' own projects_db.connect() uses).

    `immutable=1` would also open without the sidecar, but it bypasses the WAL
    entirely and would read a stale active_id — precisely the value we care
    about being fresh. Never use it here.
    """
    for uri, kwargs in (
        (f"file:{db_path}?mode=ro", {"uri": True}),
        (db_path, {}),
    ):
        try:
            return sqlite3.connect(uri, timeout=2.0, **kwargs)
        except sqlite3.Error as e:
            debug(f"projects.db open failed ({uri}): {e}")
    return None


def active_project(db_path=None):
    """Return (slug, primary_path) for the active Hermes project.

    Reads ~/.hermes/projects.db — the same store the desktop UI and the
    `project_switch` tool write to. Returns (None, None) when nothing is
    active or the DB can't be read; callers then fall back to pass-through
    behaviour rather than guessing.

    HERMES_PROJECT_SLUG overrides the DB (used by the tests and for pinning a
    project from a shell).
    """
    db_path = db_path or PROJECTS_DB
    forced = (os.environ.get("HERMES_PROJECT_SLUG") or "").strip()

    if not os.path.exists(db_path):
        return (sanitize_label(forced), None) if forced else (None, None)

    conn = _connect_projects_db(db_path)
    if conn is None:
        return (sanitize_label(forced), None) if forced else (None, None)

    try:
        conn.row_factory = sqlite3.Row
        if forced:
            row = conn.execute(
                "SELECT id, slug, primary_path FROM projects WHERE slug = ?", (forced,)
            ).fetchone()
            if row is None:
                debug(f"HERMES_PROJECT_SLUG={forced!r} matches no project")
                return sanitize_label(forced), None
        else:
            meta = conn.execute(
                "SELECT value FROM project_meta WHERE key = 'active_id'"
            ).fetchone()
            if not meta or not meta["value"]:
                return None, None
            row = conn.execute(
                "SELECT id, slug, primary_path FROM projects WHERE id = ?",
                (meta["value"],),
            ).fetchone()
            if row is None:
                debug(f"active_id {meta['value']!r} matches no project")
                return None, None

        path = (row["primary_path"] or "").strip()
        if not path:
            folder = conn.execute(
                "SELECT path FROM project_folders WHERE project_id = ? "
                "ORDER BY is_primary DESC LIMIT 1",
                (row["id"],),
            ).fetchone()
            path = (folder["path"] if folder else "") or ""
        return sanitize_label(row["slug"]), (path or None)
    except sqlite3.Error as e:
        debug(f"projects.db query failed: {e}")
        return (sanitize_label(forced), None) if forced else (None, None)
    finally:
        conn.close()


def known_slugs(db_path=None):
    """All project slugs, for recognising an already-scoped task id."""
    db_path = db_path or PROJECTS_DB
    if not os.path.exists(db_path):
        return frozenset()
    conn = _connect_projects_db(db_path)
    if conn is None:
        return frozenset()
    try:
        return frozenset(
            sanitize_label(r[0]) for r in conn.execute("SELECT slug FROM projects")
            if r and r[0]
        )
    except sqlite3.Error as e:
        debug(f"slug list failed: {e}")
        return frozenset()
    finally:
        conn.close()


def split_scoped(task_id, slugs=None):
    """Split "default.alpha" into ("default", "alpha") when the suffix is a
    known project slug; otherwise ("default.alpha", None).

    This is how the shim recognises that something upstream — the
    hermes-projects-* plugin — has already chosen the project for this task.
    When it has, the shim must not choose again: the plugin decides per
    session, while the shim can only see the global active project, and when
    the two disagree the label gets scoped twice ("default.alpha.beta")
    and the session is routed to another project's container.
    """
    if not task_id or "." not in task_id:
        return task_id, None
    slugs = known_slugs() if slugs is None else slugs
    base, _, suffix = task_id.rpartition(".")
    if suffix in slugs:
        return base, suffix
    return task_id, None


def project_path_for_slug(slug, db_path=None):
    """Primary directory for *slug*, or None."""
    if not slug:
        return None
    db_path = db_path or PROJECTS_DB
    conn = _connect_projects_db(db_path)
    if conn is None:
        return None
    try:
        row = conn.execute(
            "SELECT COALESCE(NULLIF(p.primary_path, ''), "
            "  (SELECT f.path FROM project_folders f "
            "   WHERE f.project_id = p.id ORDER BY f.is_primary DESC LIMIT 1)) "
            "FROM projects p WHERE p.slug = ?",
            (slug,),
        ).fetchone()
    except sqlite3.Error as e:
        debug(f"project path lookup failed: {e}")
        return None
    finally:
        conn.close()
    return (row[0] or None) if row else None


def sanitize_label(value):
    if not isinstance(value, str) or not value:
        return "unknown"
    return _LABEL_SAFE_RE.sub("_", value)[:63] or "unknown"


# Task ids that must NOT be partitioned by project. Hermes' backend probe
# (agent/prompt_builder.py) only checks that the terminal backend answers; it
# reads no project files. Scoping it would spawn a second ~1GB container per
# project for no benefit, so every project shares one probe container.
UNSCOPED_TASK_IDS = frozenset({"prompt-backend-probe"})


def scope_task_id(task_id, slug):
    """Partition a Hermes task id by project: "default" -> "default.alpha".

    Idempotent — re-scoping an already-scoped id is a no-op, so a value that
    round-trips through `docker run` and back out of `docker ps` stays stable.
    """
    if not slug or task_id in UNSCOPED_TASK_IDS:
        return task_id
    suffix = "." + slug
    if task_id.endswith(suffix):
        return task_id
    return sanitize_label(task_id + suffix)


def unscope_task_id(task_id, slug):
    if slug and task_id.endswith("." + slug):
        return task_id[: -(len(slug) + 1)]
    return task_id


# --------------------------------------------------------------------------
# Apple Container queries
# --------------------------------------------------------------------------

def run_container_cli(args, timeout=30):
    """Run the `container` CLI, returning (returncode, stdout, stderr)."""
    try:
        proc = subprocess.run(
            [CONTAINER_BIN] + args,
            capture_output=True, text=True, encoding="utf-8", errors="replace",
            timeout=timeout, stdin=subprocess.DEVNULL,
        )
        return proc.returncode, proc.stdout, proc.stderr
    except (subprocess.TimeoutExpired, OSError) as e:
        return 1, "", str(e)


# Apple Container reports "stopped"; Docker (and Hermes' state checks) say
# "exited". Translate so `state != "running"` logic behaves identically.
_STATE_MAP = {"stopped": "exited", "running": "running", "created": "created"}


def list_containers():
    """Return normalized container records from `container list --all`."""
    rc, out, err = run_container_cli(["list", "--all", "--format", "json"])
    if rc != 0:
        debug(f"container list failed: {err.strip()}")
        return []
    try:
        raw = json.loads(out)
    except ValueError:
        return []
    if not isinstance(raw, list):
        return []

    records = []
    for entry in raw:
        if not isinstance(entry, dict):
            continue
        cfg = entry.get("configuration") or {}
        status = entry.get("status") or {}
        cid = entry.get("id") or cfg.get("id") or ""
        state = str(status.get("state") or "").lower()
        image = ((cfg.get("image") or {}).get("reference")) or ""
        records.append({
            "ID": cid,
            "Names": cid,          # Apple Container: name *is* the id
            "Name": cid,
            "Image": image,
            "State": _STATE_MAP.get(state, state or "unknown"),
            "Status": _STATE_MAP.get(state, state or "unknown"),
            "CreatedAt": cfg.get("creationDate") or "",
            "Labels": cfg.get("labels") or {},
            "_mounts": cfg.get("mounts") or [],
        })
    return records


def inspect_container(name):
    rc, out, _ = run_container_cli(["inspect", name])
    if rc != 0:
        return None
    try:
        data = json.loads(out)
    except ValueError:
        return None
    if isinstance(data, list):
        return data[0] if data else None
    return data


def container_exists(name):
    rc, _, _ = run_container_cli(["inspect", name])
    return rc == 0


# --------------------------------------------------------------------------
# Go template subset
# --------------------------------------------------------------------------

_LABEL_TMPL_RE = re.compile(r'\{\{\s*\.Label\s+"([^"]+)"\s*\}\}')
_JSON_TMPL_RE = re.compile(r"\{\{\s*json\s+\.([A-Za-z0-9_.]+)\s*\}\}")
_FIELD_TMPL_RE = re.compile(r"\{\{\s*\.([A-Za-z0-9_.]+)\s*\}\}")


def _lookup(record, dotted):
    """Resolve "State.FinishedAt" against a nested dict."""
    cur = record
    for part in dotted.split("."):
        if isinstance(cur, dict):
            if part in cur:
                cur = cur[part]
                continue
            return None
        return None
    return cur


def render_template(tmpl, record):
    """Render the Go-template subset Hermes actually uses.

    Supports {{.Field}}, {{.Nested.Field}}, {{.Label "k"}} and {{json .X}}.
    Docker renders a missing value as "<no value>"; we match that so Hermes'
    own `egress_val not in ("", "<no value>", "off")` check behaves the same.
    """
    def label_sub(m):
        val = (record.get("Labels") or {}).get(m.group(1))
        return val if val is not None else "<no value>"

    def json_sub(m):
        return json.dumps(_lookup(record, m.group(1)))

    def field_sub(m):
        val = _lookup(record, m.group(1))
        if val is None:
            return "<no value>"
        if isinstance(val, (dict, list)):
            return json.dumps(val)
        return str(val)

    out = _LABEL_TMPL_RE.sub(label_sub, tmpl)
    out = _JSON_TMPL_RE.sub(json_sub, out)
    out = _FIELD_TMPL_RE.sub(field_sub, out)
    return out.replace("\\t", "\t").replace("\\n", "\n")


# --------------------------------------------------------------------------
# docker ps
# --------------------------------------------------------------------------

def parse_ps_args(args, slug):
    """Split `docker ps` args into (show_all, label_filters, format, quiet)."""
    show_all = False
    quiet = False
    fmt = None
    filters = {}
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-a", "--all"):
            show_all = True
        elif arg in ("-q", "--quiet"):
            quiet = True
        elif arg == "--format" and i + 1 < len(args):
            fmt = args[i + 1]
            i += 1
        elif arg.startswith("--format="):
            fmt = arg.split("=", 1)[1]
        elif arg in ("-f", "--filter") and i + 1 < len(args):
            _add_filter(filters, args[i + 1], slug)
            i += 1
        elif arg.startswith("--filter="):
            _add_filter(filters, arg.split("=", 1)[1], slug)
        i += 1
    return show_all, filters, fmt, quiet


def _add_filter(filters, spec, slug):
    """Record a `label=k=v` filter, scoping the task-id value by project.

    Scoping the *query* the same way we scope the stored label is what makes
    Hermes' reuse probe find its own project's container and nothing else.
    """
    if not spec.startswith("label="):
        # status=/name=/id= filters
        key, _, val = spec.partition("=")
        if val:
            filters.setdefault("_field", {})[key] = val
        return
    body = spec[len("label="):]
    key, sep, val = body.partition("=")
    if not sep:
        filters.setdefault("_present", set()).add(key)
        return
    if key == TASK_LABEL:
        # If the queried id already carries a project (set by the plugin),
        # search for it verbatim. Re-scoping here would look for
        # "default.alpha.beta" and either miss or, worse, match a
        # double-scoped container belonging to another project.
        _, existing = split_scoped(val)
        if existing is None:
            val = scope_task_id(val, slug)
    filters.setdefault("_labels", {})[key] = val


def filter_records(records, filters, show_all):
    out = []
    labels = filters.get("_labels", {})
    present = filters.get("_present", set())
    fields = filters.get("_field", {})
    for rec in records:
        if not show_all and rec["State"] != "running":
            continue
        rec_labels = rec.get("Labels") or {}
        if any(rec_labels.get(k) != v for k, v in labels.items()):
            continue
        if any(k not in rec_labels for k in present):
            continue
        if "status" in fields and rec["State"] != fields["status"]:
            continue
        if "name" in fields and fields["name"] not in rec["Names"]:
            continue
        if "id" in fields and not rec["ID"].startswith(fields["id"]):
            continue
        out.append(rec)
    return out


def handle_ps(args):
    slug, _ = active_project() if load_config().get("per_project", True) else (None, None)
    show_all, filters, fmt, quiet = parse_ps_args(args, slug)
    records = filter_records(list_containers(), filters, show_all)

    if quiet:
        for rec in records:
            print(rec["ID"])
    elif fmt:
        for rec in records:
            print(render_template(fmt, rec))
    else:
        print(f"{'CONTAINER ID':<16} {'IMAGE':<40} {'STATE':<10} {'CREATED'}")
        for rec in records:
            print(f"{rec['ID']:<16} {rec['Image']:<40} {rec['State']:<10} {rec['CreatedAt']}")
    sys.exit(0)


# --------------------------------------------------------------------------
# docker inspect
# --------------------------------------------------------------------------

def _docker_shaped_container(name):
    """Build the Docker-shaped inspect view Hermes' templates expect.

    Only the fields Hermes reads are populated:
      {{.State.FinishedAt}}       — idle/orphan reaping
      {{.HostConfig.NetworkMode}} — the egress lockdown guard
    """
    raw = inspect_container(name)
    if raw is None:
        return None
    cfg = raw.get("configuration") or {}
    status = raw.get("status") or {}
    state = _STATE_MAP.get(str(status.get("state") or "").lower(), "unknown")
    networks = cfg.get("networks") or []
    # Hermes only distinguishes "none" (air-gapped) from everything else.
    network_mode = "none" if not networks else (networks[0].get("network") or "default")
    return {
        "Id": raw.get("id") or cfg.get("id") or name,
        "Name": "/" + (raw.get("id") or name),
        "Image": ((cfg.get("image") or {}).get("reference")) or "",
        "Created": cfg.get("creationDate") or "",
        "State": {
            "Status": state,
            "Running": state == "running",
            "StartedAt": status.get("startedDate") or "",
            # Apple Container reports no finish time; the empty string is what
            # Hermes' _container_finished_at() already treats as "unknown".
            "FinishedAt": "",
        },
        "Config": {
            "Image": ((cfg.get("image") or {}).get("reference")) or "",
            "Labels": cfg.get("labels") or {},
            "Entrypoint": ((cfg.get("initProcess") or {}).get("executable")) or None,
        },
        "HostConfig": {"NetworkMode": network_mode},
        "Mounts": [
            {"Source": m.get("source", ""), "Destination": m.get("destination", "")}
            for m in (cfg.get("mounts") or [])
        ],
    }


def handle_inspect(args):
    fmt = None
    targets = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--format" and i + 1 < len(args):
            fmt = args[i + 1]
            i += 1
        elif arg.startswith("--format="):
            fmt = arg.split("=", 1)[1]
        elif arg in ("--type", "-s", "--size"):
            pass
        elif not arg.startswith("-"):
            targets.append(arg)
        i += 1

    if not targets:
        log("ERROR: inspect requires a container")
        sys.exit(1)

    views = [v for v in (_docker_shaped_container(t) for t in targets) if v is not None]
    if not views:
        print(f"Error: No such object: {targets[0]}", file=sys.stderr)
        sys.exit(1)

    if fmt:
        for view in views:
            print(render_template(fmt, view))
    else:
        print(json.dumps(views, indent=2))
    sys.exit(0)


def handle_image_inspect(args):
    """`docker image inspect <img> --format '{{json .Config.Entrypoint}}'`.

    Hermes uses this to detect s6-overlay images (which already supply their
    own PID 1) so it can skip --init and avoid two competing inits.
    """
    fmt = None
    targets = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--format" and i + 1 < len(args):
            fmt = args[i + 1]
            i += 1
        elif arg.startswith("--format="):
            fmt = arg.split("=", 1)[1]
        elif not arg.startswith("-"):
            targets.append(arg)
        i += 1

    if not targets:
        sys.exit(1)

    rc, out, err = run_container_cli(["image", "inspect"] + targets, timeout=60)
    if rc != 0:
        sys.stderr.write(err)
        sys.exit(rc)
    try:
        data = json.loads(out)
    except ValueError:
        sys.exit(1)

    views = []
    for entry in data if isinstance(data, list) else [data]:
        variants = entry.get("variants") or []
        image_cfg = {}
        for variant in variants:
            inner = (variant.get("config") or {}).get("config") or {}
            if inner:
                image_cfg = inner
                break
        views.append({
            "Id": entry.get("id", ""),
            "Config": {
                "Entrypoint": image_cfg.get("Entrypoint"),
                "Cmd": image_cfg.get("Cmd"),
                "Env": image_cfg.get("Env"),
            },
        })

    if fmt:
        for view in views:
            print(render_template(fmt, view))
    else:
        print(json.dumps(views, indent=2))
    sys.exit(0)


# --------------------------------------------------------------------------
# docker run
# --------------------------------------------------------------------------

def split_volume(spec):
    """Split "src:dst[:opts]" honouring the spaces macOS paths contain.

    Splitting naively on ":" breaks a path like
    "/Users/you/Alpha/Subproject:/workspace/Subproject" only when a
    component itself contains a colon, which is rare — but the destination is
    always absolute, so anchoring on ":/" is unambiguous.
    """
    match = re.match(r"^(.*?):(/[^:]*)(?::([^:]*))?$", spec)
    if not match:
        return None, None, None
    return match.group(1), match.group(2), match.group(3)


def rewrite_run_args(args, slug, project_path, config, already_scoped=False):
    """Repoint the workspace/home mounts, and scope the task-id label.

    When *already_scoped* is true the label was set by the plugin and is left
    exactly as-is — re-scoping it here would append a second project suffix.

    Returns (new_args, notes) — notes are human-readable strings describing
    each rewrite, for the log line.
    """
    notes = []
    if not slug:
        return args, notes

    out = []
    i = 0
    scoped_task = None

    while i < len(args):
        arg = args[i]

        # --- label: hermes-task-id=<id> -> <id>.<slug> ---
        if arg == "--label" and i + 1 < len(args):
            key, sep, val = args[i + 1].partition("=")
            if key == TASK_LABEL and sep:
                new_val = val if already_scoped else scope_task_id(val, slug)
                out.extend(["--label", f"{key}={new_val}"])
                if new_val != val:
                    scoped_task = new_val
                    notes.append(f"task-id {val} -> {new_val}")
                elif already_scoped:
                    notes.append(f"task-id {val} (scoped upstream)")
                else:
                    notes.append(f"task-id {val} left unscoped (shared)")
                i += 2
                continue
            out.extend([arg, args[i + 1]])
            i += 2
            continue

        # --- volumes ---
        if arg in ("-v", "--volume") and i + 1 < len(args):
            new_spec, note = _rewrite_volume(args[i + 1], slug, project_path, config)
            if note:
                notes.append(note)
            if new_spec is not None:
                out.extend(["--volume", new_spec])
            i += 2
            continue
        if arg.startswith(("-v=", "--volume=")):
            new_spec, note = _rewrite_volume(
                arg.split("=", 1)[1], slug, project_path, config
            )
            if note:
                notes.append(note)
            if new_spec is not None:
                out.extend(["--volume", new_spec])
            i += 1
            continue

        out.append(arg)
        i += 1

    # Keep the container name aligned with the scoped task id so `container
    # list` stays readable; Hermes only ever uses the id we echo back.
    if scoped_task:
        out = _retag_name(out, slug)
    return out, notes


def _rewrite_volume(spec, slug, project_path, config):
    """Repoint one volume. Returns (new_spec_or_None, note)."""
    src, dst, opts = split_volume(spec)
    if src is None:
        return spec, None

    def rebuild(new_src):
        return new_src + ":" + dst + (":" + opts if opts else "")

    # The workspace mount: always the active project's directory.
    if dst == "/workspace":
        if project_path and os.path.isdir(project_path):
            if os.path.abspath(src) == os.path.abspath(project_path):
                return spec, None
            return rebuild(project_path), f"/workspace {src} -> {project_path}"
        fallback = config.get("fallback_project_path") or ""
        if fallback and os.path.isdir(fallback):
            return rebuild(fallback), f"/workspace {src} -> {fallback} (fallback)"
        return spec, None

    # Nested mounts under /workspace come from a static docker_volumes entry
    # written for one specific project; they don't belong in the others.
    if dst.startswith("/workspace/"):
        if config.get("drop_foreign_subworkspace_mounts", True):
            if project_path and os.path.abspath(src).startswith(
                os.path.abspath(project_path) + os.sep
            ):
                return spec, None
            return None, f"dropped foreign mount {src}:{dst}"
        return spec, None

    # Per-project sandbox home so /root state doesn't bleed across projects.
    # ~/.hermes/sandboxes/docker/<task>/home -> .../<task>.<slug>/home
    if dst == "/root":
        norm = os.path.abspath(src)
        root = os.path.abspath(SANDBOX_ROOT)
        if norm.startswith(root + os.sep):
            rel = os.path.relpath(norm, root).split(os.sep)
            if rel and not rel[0].endswith("." + slug):
                rel[0] = scope_task_id(rel[0], slug)
                new_src = os.path.join(root, *rel)
                try:
                    os.makedirs(new_src, exist_ok=True)
                except OSError as e:
                    debug(f"could not create {new_src}: {e}")
                    return spec, None
                return rebuild(new_src), f"/root {src} -> {new_src}"
    return spec, None


def _retag_name(args, slug):
    out = []
    i = 0
    while i < len(args):
        if args[i] == "--name" and i + 1 < len(args):
            name = args[i + 1]
            if not name.endswith("-" + slug):
                name = f"{name}-{slug}"[:63]
            out.extend(["--name", name])
            i += 2
            continue
        if args[i].startswith("--name="):
            name = args[i].split("=", 1)[1]
            if not name.endswith("-" + slug):
                name = f"{name}-{slug}"[:63]
            out.extend(["--name", name])
            i += 1
            continue
        out.append(args[i])
        i += 1
    return out


def _project_for_run(args, config):
    """Decide which project this `docker run` belongs to.

    Prefer the project already encoded in the hermes-task-id label by the
    plugin: it resolved per session, whereas the shim can only see the global
    active project. Using the label keeps concurrent sessions correct and
    prevents the two from disagreeing and double-scoping.

    Returns ``(slug, path, already_scoped)``.
    """
    if not config.get("per_project", True):
        return None, None, False

    slugs = known_slugs()
    for i, arg in enumerate(args):
        if arg == "--label" and i + 1 < len(args):
            key, sep, val = args[i + 1].partition("=")
            if key == TASK_LABEL and sep:
                _, slug = split_scoped(val, slugs)
                if slug:
                    return slug, project_path_for_slug(slug), True
                break

    # No project in the label — the plugin isn't installed (or this is the
    # shared backend probe). Fall back to the globally active project.
    slug, path = active_project()
    return slug, path, False


def handle_run(args):
    config = load_config()
    slug, project_path, already_scoped = _project_for_run(args, config)

    if slug:
        args, notes = rewrite_run_args(
            args, slug, project_path, config, already_scoped=already_scoped
        )
        if notes:
            source = "from task label" if already_scoped else "from active project"
            log(f"project '{slug}' ({source}): " + "; ".join(notes))
    else:
        debug("no project resolved — passing run through unscoped")

    translated = translate_args(args, subcommand="run")
    debug("run: " + " ".join(translated))
    proc = subprocess.run([CONTAINER_BIN, "run"] + translated)
    sys.exit(proc.returncode)


# --------------------------------------------------------------------------
# Flag translation
# --------------------------------------------------------------------------

def translate_args(args, subcommand="run"):
    """Translate Docker flags into Apple Container equivalents.

    Apple Container accepts -v/--volume (undocumented but functional), -e, -w,
    -p, -i, -t, -d, --init, --rm, --label, --cap-add/--cap-drop, --tmpfs and
    --shm-size directly, so most flags survive untouched. Only genuinely
    unsupported ones are dropped.
    """
    result = []
    i = 0
    while i < len(args):
        arg = args[i]
        extra = 0

        if arg in STRIP_WITH_VALUE:
            extra = 1
        elif arg in STRIP_FLAGS:
            pass
        elif any(arg.startswith(f + "=") for f in STRIP_WITH_VALUE | STRIP_FLAGS):
            pass
        # --network=none has no Apple Container equivalent. Dropping it would
        # silently un-airgap a container Hermes asked to isolate, so refuse
        # instead of pretending it worked.
        elif arg in ("--network=none", "--net=none"):
            log("ERROR: --network=none (air-gapped container) is not supported "
                "by Apple Container. Refusing rather than silently granting "
                "network access. Set terminal.docker_network: true.")
            sys.exit(125)
        elif arg in ("--network", "--net") and i + 1 < len(args):
            if args[i + 1] == "none":
                log("ERROR: --network none is not supported by Apple Container. "
                    "Refusing rather than silently granting network access.")
                sys.exit(125)
            result.extend(["--network", args[i + 1]])
            extra = 1
        elif arg == "-t":
            result.append("--tag" if subcommand == "build" else "--tty")
        elif arg == "-v":
            extra = 1
            if i + 1 < len(args):
                result.extend(["--volume", args[i + 1]])
        elif arg.startswith("-v="):
            result.extend(["--volume", arg.split("=", 1)[1]])
        elif arg == "-e":
            extra = 1
            if i + 1 < len(args):
                result.extend(["--env", args[i + 1]])
        elif arg.startswith(("-e=", "--env=")):
            result.extend(["--env", arg.split("=", 1)[1]])
        elif arg == "-w":
            extra = 1
            if i + 1 < len(args):
                result.extend(["--workdir", args[i + 1]])
        elif arg.startswith("-w="):
            result.extend(["--workdir", arg.split("=", 1)[1]])
        elif arg == "-p":
            extra = 1
            if i + 1 < len(args):
                result.extend(["--publish", args[i + 1]])
        elif arg == "-d":
            result.append("--detach")
        elif arg == "-i":
            result.append("--interactive")
        elif arg == "-l":
            extra = 1
            if i + 1 < len(args):
                result.extend(["--label", args[i + 1]])
        elif arg == "-u":
            extra = 1
            if i + 1 < len(args):
                result.extend(["--user", args[i + 1]])
        elif arg == "--cpus":
            extra = 1
            if i + 1 < len(args):
                # Apple Container wants a whole number of CPUs.
                try:
                    result.extend(["--cpus", str(max(1, int(float(args[i + 1]))))])
                except ValueError:
                    pass
        elif arg == "--memory":
            extra = 1
            if i + 1 < len(args):
                result.extend(["--memory", args[i + 1]])
        else:
            result.append(arg)

        i += 1 + extra
    return result


# --------------------------------------------------------------------------
# Simple routed commands
# --------------------------------------------------------------------------

def handle_exec(args):
    """`docker exec [opts] CONTAINER CMD...` -> `container exec [opts] ID CMD...`."""
    flags = []
    rest = list(args)
    takes_value = frozenset({"-e", "--env", "-w", "--workdir", "-u", "--user", "--uid", "--gid"})
    while rest and rest[0].startswith("-"):
        flag = rest.pop(0)
        if flag in ("-i", "--interactive", "-t", "--tty", "-d", "--detach"):
            flags.append(flag)
            continue
        if flag == "--privileged":
            continue
        if flag in takes_value:
            flags.append(flag)
            if rest:
                flags.append(rest.pop(0))
            continue
        if "=" in flag:
            flags.append(flag)
            continue
        flags.append(flag)

    if not rest:
        log("ERROR: no container specified for exec")
        sys.exit(1)

    target = rest.pop(0)
    translated = translate_args(flags, subcommand="exec")
    cmd = [CONTAINER_BIN, "exec"] + translated + [target] + rest
    debug("exec: " + " ".join(cmd))
    proc = subprocess.run(cmd)
    sys.exit(proc.returncode)


def handle_simple(action, args, drop_flags=()):
    """Route rm/start/stop, dropping flags Apple Container lacks."""
    targets, passthrough = [], []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in drop_flags:
            # -t <secs> for `docker stop` takes a value
            if arg in ("-t", "--time") and i + 1 < len(args):
                i += 2
                continue
            i += 1
            continue
        if arg.startswith("-"):
            passthrough.append(arg)
        else:
            targets.append(arg)
        i += 1

    if not targets:
        log(f"ERROR: no container specified for {action}")
        sys.exit(1)

    rc = 0
    for target in targets:
        proc = subprocess.run([CONTAINER_BIN, action] + passthrough + [target])
        rc = rc or proc.returncode
    sys.exit(rc)


# --------------------------------------------------------------------------
# Entry point
# --------------------------------------------------------------------------

def main():
    if len(sys.argv) < 2:
        subprocess.run([CONTAINER_BIN, "--help"])
        sys.exit(0)

    command = sys.argv[1]
    args = sys.argv[2:]

    if command in ("--version", "-v", "version"):
        # Hermes' _ensure_docker_available() only checks that this succeeds.
        print("Docker version 25.0.0, build apple-container-shim")
        print(" API version: 1.44")
        sys.exit(0)

    if command in ("help", "--help", "-h"):
        subprocess.run([CONTAINER_BIN, "--help"])
        sys.exit(0)

    if command == "run":
        handle_run(args)
    elif command == "exec":
        handle_exec(args)
    elif command in ("ps", "container-ls"):
        handle_ps(args)
    elif command == "inspect":
        handle_inspect(args)
    elif command == "rm":
        handle_simple("delete", args, drop_flags=("-f", "--force", "-v", "--volumes"))
    elif command == "start":
        handle_simple("start", args, drop_flags=("-a", "--attach", "-i", "--interactive"))
    elif command == "stop":
        handle_simple("stop", args, drop_flags=("-t", "--time"))
    elif command == "kill":
        handle_simple("kill", args)
    elif command == "info":
        fmt = None
        if "--format" in args:
            idx = args.index("--format")
            if idx + 1 < len(args):
                fmt = args[idx + 1]
        if fmt:
            # Hermes reads {{.Driver}} to decide on --storage-opt, which Apple
            # Container has no concept of. Report a driver that makes it skip.
            print(render_template(fmt, {"Driver": "virtiofs", "ServerVersion": "1.2.0"}))
        else:
            subprocess.run([CONTAINER_BIN, "system", "status"])
        sys.exit(0)
    elif command == "image":
        if args and args[0] == "inspect":
            handle_image_inspect(args[1:])
        action = {"ls": "list", "rm": "delete"}.get(args[0] if args else "", args[0] if args else "list")
        proc = subprocess.run(
            [CONTAINER_BIN, "image", action] + translate_args(args[1:], subcommand="image")
        )
        sys.exit(proc.returncode)
    elif command == "container":
        if args and args[0] in ("ls", "list", "ps"):
            handle_ps(args[1:])
        if args and args[0] == "inspect":
            handle_inspect(args[1:])
        action = {"rm": "delete"}.get(args[0] if args else "", args[0] if args else "list")
        proc = subprocess.run(
            [CONTAINER_BIN, "container", action] + translate_args(args[1:], subcommand="container")
        )
        sys.exit(proc.returncode)
    elif command == "images":
        proc = subprocess.run([CONTAINER_BIN, "image", "list"] + translate_args(args, subcommand="images"))
        sys.exit(proc.returncode)
    elif command == "pull":
        proc = subprocess.run([CONTAINER_BIN, "image", "pull"] + translate_args(args, subcommand="pull"))
        sys.exit(proc.returncode)
    elif command == "rmi":
        proc = subprocess.run([CONTAINER_BIN, "image", "delete"] + translate_args(args, subcommand="rmi"))
        sys.exit(proc.returncode)
    elif command == "tag":
        proc = subprocess.run([CONTAINER_BIN, "image", "tag"] + args)
        sys.exit(proc.returncode)
    else:
        proc = subprocess.run(
            [CONTAINER_BIN, command] + translate_args(args, subcommand=command)
        )
        sys.exit(proc.returncode)


if __name__ == "__main__":
    main()
